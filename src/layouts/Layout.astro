---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Ziting Wang — Software Engineer specializing in AI-powered applications and full-stack development." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Language initialization script (runs before page render to keep document metadata in sync) -->
    <script is:inline>
      const storedLanguage = (() => {
        try {
          return localStorage.getItem('portfolio-language') === 'zh' ? 'zh' : 'en';
        } catch {
          return 'en';
        }
      })();

      document.documentElement.lang = storedLanguage === 'zh' ? 'zh-CN' : 'en';
      document.documentElement.dataset.language = storedLanguage;

      if (storedLanguage === 'zh') {
        document.title = 'Ziting Wang | 软件工程师';
        document
          .querySelector('meta[name="description"]')
          ?.setAttribute('content', 'Ziting Wang — 专注于 AI 驱动应用与全栈开发的软件工程师。');
      }
    </script>

    <!-- Theme initialization script (runs before page render to prevent flash) -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-screen">
    <slot />
  </body>
</html>
